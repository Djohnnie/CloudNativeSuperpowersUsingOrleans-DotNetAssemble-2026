    <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParcelTracker.Abstractions\ParcelTracker.Abstractions.csproj" />
  </ItemGroup>

</Project>
